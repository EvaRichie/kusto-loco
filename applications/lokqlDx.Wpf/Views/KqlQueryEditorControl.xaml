<UserControl x:Class="lokqlDx.Wpf.Views.KqlQueryEditorControl"
             x:Name="Instance"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:avalonEdit="http://icsharpcode.net/sharpdevelop/avalonedit"
             xmlns:local="clr-namespace:lokqlDx.Wpf.Views"
             xmlns:cvts="clr-namespace:lokqlDx.Wpf.Views.Converters"
             mc:Ignorable="d" 
             d:DesignHeight="450"
             d:DesignWidth="800"
             Loaded="UserControl_Loaded">

  <UserControl.Resources>
    <cvts:FontFamilyNameConverter x:Key="FontFamilyCvt" />
    <BooleanToVisibilityConverter x:Key="BoolCvt" />
  </UserControl.Resources>
  
  <DockPanel Background="Black">
    <Grid DockPanel.Dock="Top">
      <avalonEdit:TextEditor Name="Query"
                             Padding="3"
                             Background="Black"
                             Foreground="White"
                             FontFamily="{Binding ElementName=Instance, Path=EditorFontFamily, Mode=OneWay, Converter={StaticResource FontFamilyCvt}}"
                             ShowLineNumbers="{Binding ElementName=Instance, Path=EditorShowLineNumbers, Mode=OneWay}"
                             WordWrap="{Binding ElementName=Instance, Path=EditorUseWordWrap, Mode=OneWay}"
                             FontSize="{Binding ElementName=Instance, Path=EditorFontSize, Mode=OneWay}"
                             AllowDrop="True"
                             PreviewKeyDown="Editor_PreviewKeyDown"
                             PreviewDragOver="Editor_PreviewDragOver"
                             PreviewDragEnter="Editor_PreviewDragEnter"
                             Drop="Editor_Drop" />
      <ProgressBar IsIndeterminate="true"
                   Height="8"
                   Margin="30"
                   VerticalAlignment="Bottom"
                   HorizontalAlignment="Stretch"
                   Visibility="{Binding ElementName=Instance, Path=IsLoading, Mode=OneWay, Converter={StaticResource BoolCvt}}" />
    </Grid>
  </DockPanel>
</UserControl>
